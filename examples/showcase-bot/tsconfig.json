{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "//": "In-repo example only: resolve @teactjs/* to source so there's a SINGLE module instance (shared React context). Generated user projects don't need this — they install the published packages.",
    "paths": {
      "@teactjs/core": ["../../packages/core/src"],
      "@teactjs/core/*": ["../../packages/core/src/*"],
      "@teactjs/ui": ["../../packages/ui/src"],
      "@teactjs/ui/*": ["../../packages/ui/src/*"],
      "@teactjs/telegram": ["../../packages/telegram/src"],
      "@teactjs/telegram/*": ["../../packages/telegram/src/*"],
      "@teactjs/storage": ["../../packages/storage/src"],
      "@teactjs/storage/*": ["../../packages/storage/src/*"],
      "@teactjs/plugin-sdk": ["../../packages/plugin-sdk/src"],
      "@teactjs/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    }
  },
  "include": ["src", "teact.config.ts"]
}
