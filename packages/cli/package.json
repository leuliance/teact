{
  "name": "@teact/cli",
  "version": "0.1.0-alpha.1",
  "description": "CLI tool for the Teact bot framework — create, dev, build, generate",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "teact": "src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "teact": "dist/bin.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/bin.ts ./src/index.ts --outdir ./dist --format esm --target bun && tsc --emitDeclarationOnly --outDir dist --declaration --project tsconfig.build.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^14.0.3",
    "vite": "^8.0.3",
    "vite-node": "^6.0.0"
  },
  "license": "MIT"
}
