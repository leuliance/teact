{
  "name": "@teactjs/telegram",
  "version": "0.1.0-alpha.3",
  "description": "Telegram platform adapter for Teact, powered by grammY",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/telegram/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/telegram/src/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --format esm --target bun && tsc --emitDeclarationOnly --outDir dist --declaration --project tsconfig.build.json"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/stream": "^1.0.1",
    "@teactjs/renderer": "^0.1.0-alpha.3",
    "@teactjs/react": "^0.1.0-alpha.3",
    "@teactjs/runtime": "^0.1.0-alpha.3",
    "grammy": "^1.35.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "license": "MIT"
}
