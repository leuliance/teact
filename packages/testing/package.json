{
  "name": "@teact/testing",
  "version": "0.1.0-alpha.1",
  "description": "Testing utilities for Teact bots — mock adapter, render helpers",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --format esm --target bun && tsc --emitDeclarationOnly --outDir dist --declaration --project tsconfig.build.json"
  },
  "dependencies": {
    "@teact/renderer": "workspace:*",
    "@teact/react": "workspace:*",
    "@teact/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "license": "MIT"
}
