{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@teactjs/core": ["packages/core/src"],
      "@teactjs/core/*": ["packages/core/src/*"],
      "@teactjs/plugin-sdk": ["packages/plugin-sdk/src"],
      "@teactjs/plugin-sdk/*": ["packages/plugin-sdk/src/*"],
      "@teactjs/telegram": ["packages/telegram/src"],
      "@teactjs/telegram/*": ["packages/telegram/src/*"],
      "@teactjs/ui": ["packages/ui/src"],
      "@teactjs/ui/*": ["packages/ui/src/*"],
      "@teactjs/storage": ["packages/storage/src"],
      "@teactjs/storage/*": ["packages/storage/src/*"],
      "@teactjs/testing": ["packages/testing/src"],
      "@teactjs/testing/*": ["packages/testing/src/*"],
      "@teactjs/cli": ["packages/cli/src"],
      "@teactjs/cli/*": ["packages/cli/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/dist",
    "examples",
    "packages/create-teact/lib/assets",
    "packages/cli/src/lib/assets"
  ]
}
